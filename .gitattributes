# The Gradle wrapper's Windows batch script requires CRLF line endings,
# while the POSIX shell script requires LF. Both are generated by the
# `wrapper` task, so keep git from renormalizing them.
/android/gradlew.bat text eol=crlf
/android/gradlew text eol=lf

# The Gradle wrapper JAR must never be treated as text.
/android/gradle/wrapper/gradle-wrapper.jar binary
